# Netlify — Variables d'environnement (à configurer dans Netlify Dashboard)

# Turso (base de données serverless)
TURSO_DB_URL=libsql://ton-projet.turso.io
TURSO_DB_TOKEN=ton-token-ici

# NextAuth
AUTH_SECRET=ton-secret-ici
AUTH_URL=https://ton-app.vercel.app

# Google OAuth
AUTH_GOOGLE_ID=ton-google-client-id
AUTH_GOOGLE_SECRET=ton-google-client-secret

# Apple (optionnel, compte Apple Developer requis)
AUTH_APPLE_ID=ton-apple-service-id
AUTH_APPLE_SECRET=ton-apple-client-secret

# IA : Google Gemini (gratuit). Crée une clé sur https://aistudio.google.com/apikey
GEMINI_API_KEY=ta-cle-gemini
# Optionnel : modèle Gemini à utiliser (par défaut gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest
