# Netlify — Variables d'environnement (à configurer dans Netlify Dashboard)

# Turso (base de données serverless)
TURSO_DB_URL=libsql://ton-projet.turso.io
TURSO_DB_TOKEN=ton-token-ici

# NextAuth
AUTH_SECRET=ton-secret-ici
AUTH_URL=https://ton-app.vercel.app

# Google OAuth
AUTH_GOOGLE_ID=ton-google-client-id
AUTH_GOOGLE_SECRET=ton-google-client-secret
